{
  "name": "@neotap.app/neo-engine",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "author": "NeoTap",
  "type": "module",
  "description": "Client runtime SDK for Neo Engine, a cross-platform game engine built on Phaser 3 (2D) and Three.js (3D).",
  "keywords": [
    "game",
    "game-engine",
    "phaser",
    "threejs",
    "minigame",
    "wechat",
    "douyin",
    "h5",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neotap-app/neo-engine.git",
    "directory": "packages/neo-engine"
  },
  "homepage": "https://github.com/neotap-app/neo-engine#readme",
  "bugs": {
    "url": "https://github.com/neotap-app/neo-engine/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
