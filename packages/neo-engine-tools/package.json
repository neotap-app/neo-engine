{
  "name": "@neotap.app/neo-engine-tools",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "author": "NeoTap",
  "type": "module",
  "description": "Build tools and CLI for Neo Engine: transpile and bundle mini game and H5 output, with a headless build API.",
  "keywords": [
    "game",
    "game-engine",
    "phaser",
    "threejs",
    "minigame",
    "wechat",
    "douyin",
    "h5",
    "typescript",
    "cli",
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neotap-app/neo-engine.git",
    "directory": "packages/neo-engine-tools"
  },
  "homepage": "https://github.com/neotap-app/neo-engine#readme",
  "bugs": {
    "url": "https://github.com/neotap-app/neo-engine/issues"
  },
  "exports": {
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js",
      "require": "./dist/build/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "neo": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@neotap.app/neo-engine": "workspace:*",
    "typescript": "^5.5.0",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsup": "^8.0.0"
  }
}
